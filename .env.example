# Postgres connection (compose default below)
DATABASE_URL=postgres://invex:invex@localhost:5432/invex

# Docling Serve
DOCLING_URL=http://localhost:5001

# VLM backend (OpenAI-compatible, optional) — off unless VLM_MODEL set AND vlm.enabled (config/pipeline.json, overridable here)
VLM_URL=http://localhost:11434
VLM_MODEL=
VLM_ENABLED=
# Bearer token, for authenticated gateways (e.g. LiteLLM); empty = no auth header
VLM_API_KEY=
# "response_format" (vLLM/llama.cpp/OpenAI style) | "ollama_format" (Ollama native `format` field)
VLM_SCHEMA_MODE=response_format

# HTTP server
PORT=8080
LOG_LEVEL=info
