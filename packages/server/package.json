{
  "name": "@invex/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "InvEx service: Fastify API, Drizzle persistence, pipeline worker, Docling/VLM clients.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
