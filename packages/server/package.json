    "smoke": "tsx src/scripts/batchIngest.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@invex/core": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pdfjs-dist": "^6.1.200",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@invex/fixtures": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.31.10",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4"
  }
